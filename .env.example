# PostgreSQL connection string for the local RAG database.
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/ai_assistant

# Ollama defaults; change these only if your local setup differs.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
OLLAMA_CHAT_MODEL=qwen3:4b

# Number of nearest chunks to retrieve per question (1–20).
RAG_TOP_K=5

# Next.js browser client -> NestJS API.
NEXT_PUBLIC_API_URL=http://localhost:3001
